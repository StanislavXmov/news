BITRIX_BASE_URL=https://example.com
BITRIX_NEWS_PATH=/news/
BITRIX_LIST_ITEM_SELECTOR=a.news-item
BITRIX_NEXT_PAGE_SELECTOR=a.next
BITRIX_TITLE_SELECTOR=h1
BITRIX_DATE_SELECTOR=time
BITRIX_CONTENT_SELECTOR=.news-detail
BITRIX_IMAGE_SELECTOR=.news-detail img
BITRIX_MAX_PAGES=1000
BITRIX_MAX_ITEMS=0
BITRIX_DELAY_MS=200
BITRIX_OUTPUT=output/news.json
